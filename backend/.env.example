# ============================================
# HMS Backend - Environment Variables
# Copy this file to .env and fill in values
# NEVER commit the actual .env file to GitHub
# ============================================

# Server
PORT=5002

# Vercel Postgres Database URL
POSTGRES_URL=postgres://default:password@host.postgres.vercel-storage.com:5432/verceldb

# JWT Authentication Secret (use a long random string)
JWT_SECRET=your_secure_random_jwt_secret_key_here

# Frontend URL (for CORS - your deployed frontend URL)
CLIENT_URL=https://your-hms-frontend.vercel.app

# DB Init Secret Key (to protect /api/init-db route)
INIT_SECRET=your_secret_key_to_protect_init_route
